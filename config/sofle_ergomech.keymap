#define ZMK_POINTING_DEFAULT_SCRL_VAL 300

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };

    behaviors {
        mousescroll: mousescroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Layer_0 {
            label = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp HOME       &kp N1     &kp N2          &kp N3            &kp N4              &kp N5        &kp N6       &kp N7               &kp N8             &kp N9           &kp N0          &kp MINUS
&kp END        &kp Q      &kp W           &kp E             &kp R               &kp T         &kp Y        &kp U                &kp I              &kp O            &kp P           &kp EQUAL
&kp BACKSPACE  &kp A      &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LEFT_CONTROL F  &kp G         &kp H        &mt RIGHT_CONTROL J  &mt RIGHT_SHIFT K  &mt RIGHT_ALT L  &kp SEMI        &kp SQT
&kp DEL        &kp Z      &kp X           &kp C             &kp V               &kp B         &kp N        &kp M                &kp COMMA          &kp DOT          &kp FSLH        &lt 2 ENTER
&kp C_MUTE     &kp LCTRL  &kp LALT        &kp TAB           &kp LEFT_SHIFT      &lt 1 RETURN  &lt 1 SPACE  &kp BACKSPACE        &kp DEL            &kp ESCAPE       &tog 3
                                                                                              &mkp LCLK    &mmv MOVE_RIGHT      &mmv MOVE_UP       &mmv MOVE_LEFT   &mmv MOVE_DOWN
            >;

            sensor-bindings = <&mousescroll &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            label = "lower";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&studio_unlock    &kp F1          &kp F2          &kp F3          &kp F4       &kp F5         &kp F6             &kp F7        &kp F8        &kp F9        &kp F10    &kp F11
&kp CAPS          &kp N1          &kp LG(LS(S))   &kp UP_ARROW    &kp AT_SIGN  &kp LC(Z)      &kp LEFT_BRACKET   &kp N7        &kp N8        &kp N9        &kp N0     &kp F12
&kp LEFT_GUI      &kp LEFT_SHIFT  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT    &kp PRCNT      &kp RIGHT_BRACKET  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp RPAR   &kp PIPE
&kp C_PLAY_PAUSE  &kp EQUAL       &kp LC(C)       &kp LC(X)       &kp LC(V)    &kp LC(LS(V))  &kp SLASH          &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp LC(B)  &trans
&kp C_MUTE        &trans          &trans          &trans          &trans       &trans         &kp RIGHT_SHIFT    &trans        &kp N0        &trans        &trans
                                                                                              &trans             &trans        &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            label = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1      &bt BT_SEL 2        &bt BT_SEL 3          &bt BT_SEL 4       &trans     &trans                &trans                 &trans          &trans          &trans
&trans      &kp INS       &kp PSCRN         &kp K_CMENU         &kp LA(LS(UP_ARROW))  &trans             &kp PG_UP  &trans                &kp UP                 &trans          &kp N0          &trans
&trans      &kp LALT      &kp LC(LS(LEFT))  &kp LC(LEFT_ARROW)  &kp LC(RIGHT)         &kp LC(LS(RIGHT))  &kp PG_DN  &kp LC(LEFT_BRACKET)  &kp LC(RIGHT_BRACKET)  &kp LS(LC(N7))  &kp LC(LS(N8))  &kp BSPC
&trans      &kp K_UNDO    &kp K_CUT         &kp K_COPY          &kp LA(LS(DOWN))      &trans             &trans     &kp LA(LS(N5))        &kp RC(U)              &kp RC(I)       &kp RC(B)       &trans
&trans      &trans        &trans            &trans              &trans                &trans             &trans     &trans                &trans                 &trans          &trans
                                                                                                         &trans     &trans                &trans                 &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Layer-3 {
            bindings = <
&kp ESC   &kp N1     &kp N2    &kp N3   &kp N4     &kp N5   &trans     &trans    &trans     &trans   &trans  &trans
&kp TAB   &kp Q      &kp W     &kp E    &kp R      &kp T    &kp Y      &kp U     &kp I      &kp O    &kp P   &trans
&kp BSPC  &kp A      &kp S     &kp D    &kp F      &kp G    &kp H      &kp J     &kp K      &kp L    &trans  &trans
&kp DEL   &kp Z      &kp X     &kp C    &kp V      &kp B    &kp N      &kp M     &kp COMMA  &kp DOT  &trans  &kp ENTER
&trans    &kp LCTRL  &kp LALT  &kp TAB  &kp LSHFT  &kp RET  &kp SPACE  &kp BSPC  &trans     &kp ESC  &tog 3
                                                            &trans     &trans    &trans     &trans   &trans
            >;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            label = "adjust";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4     &none  &none  &none  &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF  &none  &none  &none  &none  &none  &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none            &none  &none  &none  &none  &none  &none
&none              &none            &none            &none            &none            &none            &none  &none  &none  &none  &none  &none
&rgb_ug RGB_TOG    &none            &none            &none            &none            &none            &none  &none  &none  &none  &none
                                                                                                        &kp A  &kp B  &kp C  &kp D  &kp E
            >;
        };
    };
};
